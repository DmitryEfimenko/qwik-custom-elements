{
  "name": "@qwik-custom-elements/adapter-lit",
  "version": "1.0.1",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.js"
    },
    "./ssr-client": {
      "types": "./dist/ssr-client.d.ts",
      "import": "./dist/ssr-client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --write . --config ../../.prettierrc.json --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --config ../../.prettierrc.json --ignore-path ../../.prettierignore",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,mts,cts,tsx}\" --no-error-on-unmatched-pattern",
    "e2e": "node -e \"console.log('adapter-lit e2e noop')\"",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@builder.io/qwik": "^1.19.2",
    "@lit-labs/ssr": ">=4.0.0",
    "@lit-labs/ssr-client": ">=1.1.0",
    "lit": ">=3.0.0",
    "@qwik-custom-elements/core": "^1.0.1"
  },
  "peerDependenciesMeta": {
    "@lit-labs/ssr": {
      "optional": true
    },
    "@qwik-custom-elements/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.19.2",
    "@lit-labs/ssr": "^4.0.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@qwik-custom-elements/core": "workspace:*",
    "lit": "^3.3.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Lit adapter for @qwik-custom-elements — SSR via @lit-labs/ssr (Declarative Shadow DOM)",
  "keywords": [
    "qwik",
    "web-components",
    "custom-elements",
    "ssr",
    "server-side-rendering",
    "wrapper",
    "manifest",
    "lit",
    "lit-element",
    "declarative-shadow-dom"
  ],
  "author": "Dmitry A. Efimenko (https://github.com/DmitryEfimenko)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DmitryEfimenko/qwik-custom-elements.git",
    "directory": "packages/adapter-lit"
  },
  "homepage": "https://github.com/DmitryEfimenko/qwik-custom-elements#readme",
  "bugs": {
    "url": "https://github.com/DmitryEfimenko/qwik-custom-elements/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "funding": "https://github.com/sponsors/DmitryEfimenko",
  "sideEffects": false
}
