{
  "name": "@qwik-custom-elements/core",
  "version": "1.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "qwik-custom-elements": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "node ./dist/cli.js --help",
    "format": "prettier --write . --config ../../.prettierrc.json --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --config ../../.prettierrc.json --ignore-path ../../.prettierignore",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,mts,cts,tsx}\" --no-error-on-unmatched-pattern",
    "e2e": "node -e \"console.log('core e2e noop')\"",
    "test": "pnpm --filter @qwik-custom-elements/adapter-stencil run build && pnpm --filter @qwik-custom-elements/adapter-lit run build && vitest run"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Generate typed, SSR-capable Qwik components from Web Component libraries (CLI + orchestration)",
  "keywords": [
    "qwik",
    "web-components",
    "custom-elements",
    "ssr",
    "server-side-rendering",
    "wrapper",
    "manifest",
    "cli",
    "generator",
    "code-generation"
  ],
  "author": "Dmitry A. Efimenko (https://github.com/DmitryEfimenko)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DmitryEfimenko/qwik-custom-elements.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/DmitryEfimenko/qwik-custom-elements#readme",
  "bugs": {
    "url": "https://github.com/DmitryEfimenko/qwik-custom-elements/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "funding": "https://github.com/sponsors/DmitryEfimenko",
  "sideEffects": false
}
